# true = run offline without OpenAI (fake embeddings, prompt shown instead of an AI answer)
DEMO_MODE=false
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitness_coach

# The Qdrant server from docker-compose. Remove this line to use embedded Qdrant at QDRANT_PATH instead.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=protocols
RAG_TOP_K=3

# Connected apps (optional). See README, "Connect your data".
# Generate with: python -m scripts.generate_key
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
PUBLIC_API_URL=http://localhost:8000
UI_URL=http://localhost:8501
