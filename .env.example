# true = run offline without OpenAI (fake embeddings, prompt shown instead of an AI answer)
DEMO_MODE=false
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitness_coach

# The Qdrant server from docker-compose. Remove this line to use embedded Qdrant at QDRANT_PATH instead.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=protocols
RAG_TOP_K=3
